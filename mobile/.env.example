# GrowWise Example Environment
# Copy file này thành .env và điền thông tin Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# SePay payment gateway
SEPAY_ACCOUNT=          # số tài khoản ngân hàng đã liên kết SePay
SEPAY_BANK=             # mã/short name ngân hàng (vd: TPBank, MBBank, Vietcombank)
SEPAY_ACCOUNT_NAME=     # tên chủ tài khoản (hiển thị cho người dùng)
SEPAY_WEBHOOK_API_KEY=  # API key đặt ở mục Webhook trong dashboard SePay
